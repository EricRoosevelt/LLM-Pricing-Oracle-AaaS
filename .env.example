PROJECT_NAME="LLM Agent Routing Control Plane"

REDIS_URL="redis://localhost:6379/0"
DATABASE_URL="postgresql+asyncpg://oracle_user:oracle_password@localhost:5432/oracle_db"
CATALOG_PATH="models_config.json"
SIGNAL_FRESHNESS_SECONDS=90
DECISION_TTL_SECONDS=300
PROBE_INTERVAL_SECONDS=60

BOOTSTRAP_AGENT_CREDENTIALS='[
  {
    "api_key": "replace-with-a-long-random-agent-key",
    "agent_id": "Primary-Agent",
    "environment": "internal",
    "tenant_id": "internal",
    "status": "active",
    "scopes": ["routing:decide", "routing:outcome", "control:read"],
    "rate_limit_rpm": 120,
    "concurrent_limit": 25,
    "daily_budget_usd": 250,
    "default_policy_id": "balanced"
  }
]'

PROBE_PROXY=""
KIMI_API_KEY=""
DEEPSEEK_API_KEY=""
